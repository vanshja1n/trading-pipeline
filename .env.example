# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Free paper-trading keys: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Leave this false. Setting it true only *permits* live money; the bot still
# also requires the --i-know-this-is-real-money flag before it will use it.
ALPACA_LIVE=false
